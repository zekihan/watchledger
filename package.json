{
  "name": "watchledger",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "lint": "npm run lint:docs && npm run lint:web && npm run format:check",
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint:web": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:web": "npm run test --workspace web",
    "test:browser": "playwright test",
    "typecheck:browser": "tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "markdownlint": "^0.42.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "^0.19.0",
    "markdownlint": {
      "re2js": "2.8.7"
    }
  }
}
