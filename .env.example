# Export these variables in your shell. Never commit real values.
WATCHLEDGER_ADDR=127.0.0.1:8080
WATCHLEDGER_WEB_DIR=web/dist
DATABASE_URL=postgres://watchledger:change-me@localhost:5432/watchledger?sslmode=disable
PUBLIC_URL=http://127.0.0.1:8080
OIDC_ISSUER=https://identity.example.com/
OIDC_CLIENT_ID=watchledger
OIDC_CLIENT_SECRET=
OIDC_ADMISSION_CLAIM=groups
OIDC_ADMISSION_VALUE=watchledger-users
OIDC_ADMIN_CLAIM=groups
OIDC_ADMIN_VALUE=watchledger-admins
# Generate once with: openssl rand -base64 32
SESSION_KEY=
# Optional until real catalog integration is configured.
TMDB_TOKEN=
# Registered non-secret HTTP client identity. Leave both empty to disable live AniDB.
ANIDB_CLIENT=watchledger
ANIDB_CLIENT_VERSION=1
