{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret", "publicURL", "oidc"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "publicURL": {
      "type": "string",
      "minLength": 1
    },
    "oidc": {
      "type": "object",
      "required": [
        "issuer",
        "clientID",
        "admissionClaim",
        "admissionValue",
        "adminClaim",
        "adminValue"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "clientID": {
          "type": "string",
          "minLength": 1
        },
        "admissionClaim": {
          "type": "string",
          "minLength": 1
        },
        "admissionValue": {
          "type": "string",
          "minLength": 1
        },
        "adminClaim": {
          "type": "string",
          "minLength": 1
        },
        "adminValue": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "anidb": {
      "type": "object",
      "required": ["client", "version"],
      "properties": {
        "client": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
